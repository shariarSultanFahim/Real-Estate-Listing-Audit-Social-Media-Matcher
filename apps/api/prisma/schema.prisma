// =============================================================
// Real Estate Listing Audit — Prisma Schema
// Source of Truth: packages/validation/src/index.ts (Zod schemas)
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ListingStatus {
  active
  pending
  sold
  withdrawn
}

enum PropertyType {
  SingleFamily     @map("Single Family")
  CondoTownhouse   @map("Condo / Townhouse")
  MultiFamily      @map("Multi-Family")
  Commercial       @map("Commercial")
  Land             @map("Land")
  Other            @map("Other")
}

enum CrossPostPreference {
  all
  byRequest
  never
  areaAndPrice
}

enum OfficeState {
  LA
  MS
  AL
}

enum SyndicationSite {
  realtor
  zillow
  homes
  redfin
  sothebysRealty
  crescentSothebys
  mansionsGlobal
  lacdb
  google
}

enum ExternalPlatform {
  ZILLOW
  REALTOR
  LACDB
  HOMES
  REDFIN
  SOTHEBYS_REALTY
  CRESCENT_SOTHEBYS
  MANSIONS_GLOBAL
  GOOGLE
  OTHER
}

enum DiscrepancyField {
  price
  address
  description
  mapCoordinates
  photos
  legalDescription
  beds
  fullBaths
  halfBaths
  squareFeet
  status
  agent
  lotSize
  propertyType
  not_found
}

enum DiscrepancyStatus {
  open
  in_progress
  resolved
  ignored
}

enum DiscrepancyAction {
  status_change
  reopened
  note_added
  photo_approved
  ignored
  manual_resolution
}

enum AccountType {
  superAdmin
  employee
}

enum AuditRunStatus {
  pending
  running
  completed
  partial
  failed
}

// ─────────────────────────────────────────────
// LISTING OFFICE
// ─────────────────────────────────────────────

model ListingOffice {
  id        String      @id @default(uuid())
  name      String
  state     OfficeState
  address   String?
  phone     String?
  email     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  listings  Listing[]

  @@map("listing_offices")
}

// ─────────────────────────────────────────────
// AGENT
// Maps to: AgentSchema in validation
// ─────────────────────────────────────────────

model Agent {
  id                  String              @id @default(uuid())
  name                String
  email               String              @unique
  phone               String?
  officeState         OfficeState
  serviceAreas        String[]            // Array of city names
  facebookPageUrl     String?
  instagramPageUrl    String?
  crossPostPreference CrossPostPreference @default(byRequest)
  priceRangeMin       Decimal?            @db.Decimal(12, 2)
  priceRangeMax       Decimal?            @db.Decimal(12, 2)
  bio                 String?
  licenseNumber       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  listings            Listing[]

  @@index([officeState])
  @@map("agents")
}

// ─────────────────────────────────────────────
// LISTING (Source of Truth)
// Maps to: ListingSchema in validation
// Never modify based on scraped data.
// ─────────────────────────────────────────────

model Listing {
  id          String        @id @default(uuid())
  mlsNumber   String        @unique  // MLS ID / reference number

  // ── Address (flat, maps to AddressSchema) ──
  street       String
  addressLine2 String?
  city         String
  state        String
  zip          String

  // ── Financials ──
  price       Decimal       @db.Decimal(12, 2)
  status      ListingStatus @default(active)

  // ── Property Details ──
  propertyType    String
  propertyStyle   String
  subdivision     String?
  beds            Int        @default(0)
  fullBaths       Int        @default(0)
  halfBaths       Int?
  buildingAreaSqft Decimal?  @db.Decimal(10, 2)
  lotSizeAcres    Decimal?   @db.Decimal(10, 4)
  yearBuilt       Int?
  parkingPlaces   Int?
  newConstruction Boolean    @default(false)
  listingType     String     // "Residential Sales", "Commercial", etc.
  features        String[]

  // ── Descriptions ──
  description      String  @db.Text
  legalDescription String  @db.Text

  // ── Map ──
  lat  Decimal? @db.Decimal(10, 7)
  lng  Decimal? @db.Decimal(10, 7)

  // ── Dates ──
  listDate               DateTime
  expirationDate         DateTime
  anticipatedLaunchDate  DateTime?
  lastUpdatedAt          DateTime  @updatedAt

  // ── MLS Source (e.g. "Crescent Sotheby's MLS") ──
  mlsSource  String?

  // ── Photo Arrangement Approval ──
  approvedPhotoArrangementHash String?

  // ── Relations ──
  listingAgentId  String
  listingAgent    Agent          @relation(fields: [listingAgentId], references: [id])

  listingOfficeId String
  listingOffice   ListingOffice  @relation(fields: [listingOfficeId], references: [id])

  photos                   ListingPhoto[]
  siteSnapshots            SiteSnapshot[]
  siteSnapshotHistories    SiteSnapshotHistory[]
  externalListings         ExternalListing[]
  discrepancies            Discrepancy[]
  approvedPhotoArrangements ApprovedPhotoArrangement[]

  @@index([mlsNumber])
  @@index([city])
  @@index([state])
  @@index([status])
  @@index([listingAgentId])
  @@map("listings")
}

// ─────────────────────────────────────────────
// LISTING PHOTO
// Supports photo ordering audit & approval workflow
// ─────────────────────────────────────────────

model ListingPhoto {
  id         String   @id @default(uuid())
  listingId  String
  url        String
  position   Int      // 1-based sort order (matches frontend PhotoSchema.order)
  hash       String?  // Perceptual / SHA-256 hash
  source     String   @default("client") // "client" | "apify" | "manual"
  caption    String?
  approvedAt DateTime?
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_photos")
}

// ─────────────────────────────────────────────
// APPROVED PHOTO ARRANGEMENT
// Records staff-approved custom photo sequences per platform
// ─────────────────────────────────────────────

model ApprovedPhotoArrangement {
  id          String          @id @default(uuid())
  listingId   String
  site        SyndicationSite
  platform    ExternalPlatform?
  fingerprint String          // Deterministic SHA-256 hash of ordered photos
  photoCount  Int
  photoUrls   Json?           // Array of ordered URLs at approval time
  approvedAt  DateTime        @default(now())
  approvedBy  String?         // User ID who approved
  notes       String?         @db.Text

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, site, fingerprint])
  @@index([listingId, site])
  @@map("approved_photo_arrangements")
}

// ─────────────────────────────────────────────
// SITE SNAPSHOT (Latest State)
// Lightweight read model — one row per listing per syndication site.
// Maps to: SiteSnapshotSchema in validation.
// ─────────────────────────────────────────────

model SiteSnapshot {
  id        String          @id @default(uuid())
  listingId String
  site      SyndicationSite
  fetchedAt DateTime        @default(now())

  // Scraped fields (mirrors SiteSnapshotSchema)
  price       Decimal? @db.Decimal(12, 2)
  street      String?
  city        String?
  state       String?
  zip         String?
  description String?  @db.Text
  lat         Decimal? @db.Decimal(10, 7)
  lng         Decimal? @db.Decimal(10, 7)
  photos      Json?    // Array of { url, order }
  sourceUrl   String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, site])
  @@index([site])
  @@map("site_snapshots")
}

// ─────────────────────────────────────────────
// SITE SNAPSHOT HISTORY (Temporal Log)
// Keeps external historical state over multiple audit cycles
// Answers: "What did Zillow show for this listing during the previous audit?"
// ─────────────────────────────────────────────

model SiteSnapshotHistory {
  id         String          @id @default(uuid())
  listingId  String
  site       SyndicationSite
  auditRunId String?
  capturedAt DateTime        @default(now())

  price       Decimal? @db.Decimal(12, 2)
  street      String?
  city        String?
  state       String?
  zip         String?
  description String?  @db.Text
  lat         Decimal? @db.Decimal(10, 7)
  lng         Decimal? @db.Decimal(10, 7)
  photos      Json?    // Array of { url, order }
  sourceUrl   String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, site])
  @@index([capturedAt])
  @@index([auditRunId])
  @@map("site_snapshot_histories")
}

// ─────────────────────────────────────────────
// EXTERNAL LISTING
// Generic model for Apify-scraped data.
// One row per listing per platform.
// rawData stores the full scraped payload.
// ─────────────────────────────────────────────

model ExternalListing {
  id        String           @id @default(uuid())
  listingId String
  platform  ExternalPlatform

  externalId  String?  // The listing ID on the external platform
  listingUrl  String?

  // Normalized fields (mapped from rawData by actor normalizers)
  address      String?
  city         String?
  state        String?
  zipCode      String?

  price        Decimal? @db.Decimal(12, 2)
  bedrooms     Int?
  fullBaths    Int?
  halfBaths    Int?
  squareFeet   Decimal? @db.Decimal(10, 2)
  lotSize      String?

  propertyType String?
  status       String?

  description  String?  @db.Text
  agentName    String?

  // Full raw scraped payload
  rawData Json

  // Matching confidence (0–100) & structured signal metadata
  matchConfidence Int?
  matchedBy       String?  // "mls_id" | "address_exact" | "address_fuzzy" | "manual" | "none"
  matchingSignals Json?    // Breakdown of matching criteria

  scrapedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, platform])
  @@index([platform])
  @@index([externalId])
  @@map("external_listings")
}

// ─────────────────────────────────────────────
// DISCREPANCY
// Maps to: DiscrepancySchema in validation.
// Created by comparison.service.ts after matching.
// ─────────────────────────────────────────────

model Discrepancy {
  id        String           @id @default(uuid())
  listingId String
  site      SyndicationSite

  field       DiscrepancyField
  sourceValue String          @db.Text  // Value from client's listing (source of truth)
  siteValue   String          @db.Text  // Value found on external site

  status     DiscrepancyStatus @default(open)
  active     Boolean           @default(true)  // false = archived (not deleted)

  detectedAt DateTime  @default(now())
  resolvedAt DateTime?
  note       String?   @db.Text

  listing  Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  notes    DiscrepancyNote[]
  history  DiscrepancyHistory[]

  @@index([listingId])
  @@index([site])
  @@index([status])
  @@index([active])
  @@map("discrepancies")
}

// ─────────────────────────────────────────────
// DISCREPANCY NOTE
// Staff can add timestamped notes to discrepancies.
// ─────────────────────────────────────────────

model DiscrepancyNote {
  id             String   @id @default(uuid())
  discrepancyId  String
  authorId       String?  // User ID (nullable for system notes)
  content        String   @db.Text
  createdAt      DateTime @default(now())

  discrepancy Discrepancy @relation(fields: [discrepancyId], references: [id], onDelete: Cascade)

  @@index([discrepancyId])
  @@map("discrepancy_notes")
}

// ─────────────────────────────────────────────
// DISCREPANCY HISTORY
// Immutable audit trail of status changes & staff actions.
// ─────────────────────────────────────────────

model DiscrepancyHistory {
  id             String             @id @default(uuid())
  discrepancyId  String
  changedBy      String?            // User ID
  action         DiscrepancyAction  @default(status_change)
  fromStatus     DiscrepancyStatus?
  toStatus       DiscrepancyStatus?
  note           String?
  changedAt      DateTime           @default(now())

  discrepancy Discrepancy @relation(fields: [discrepancyId], references: [id], onDelete: Cascade)

  @@index([discrepancyId])
  @@index([changedAt])
  @@map("discrepancy_history")
}

// ─────────────────────────────────────────────
// USER (System accounts — employees and admins)
// Maps to: UserSchema in validation.
// ─────────────────────────────────────────────

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String      // bcrypt hash — never returned to frontend
  accountType  AccountType @default(employee)
  permissions  String[]    // Array of PermissionEnum values

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([accountType])
  @@map("users")
}

// ─────────────────────────────────────────────
// AUDIT RUN
// Tracks each automated scrape + comparison cycle.
// ─────────────────────────────────────────────

model AuditRun {
  id                   String            @id @default(uuid())
  platform             ExternalPlatform?
  triggeredBy          String?           // User ID or "scheduler" or "manual"
  startedAt            DateTime          @default(now())
  finishedAt           DateTime?
  completedAt          DateTime?         // Alias for finishedAt
  status               AuditRunStatus    @default(pending)
  listingsProcessed    Int               @default(0)
  listingsMatched      Int               @default(0)
  listingsUnmatched    Int               @default(0)
  discrepanciesFound   Int               @default(0)
  discrepanciesCreated Int               @default(0)
  errors               Json?             // Array of error details
  errorLog             Json?             // Deprecated alias for errors

  @@index([status])
  @@index([startedAt])
  @@map("audit_runs")
}
