# ==============================================================================
# Real Estate Listing Audit & Social Media Matcher — API Environment Config
# ==============================================================================

# Database
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_estate_db?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Authentication & Security
# Change JWT_SECRET to a strong random string in production!
JWT_SECRET="dev-jwt-secret-replace-with-secure-key-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# Matching Engine Configuration
# Threshold for automatic high/strong match association (0-100)
MATCH_CONFIDENCE_THRESHOLD=70
# Threshold for high-confidence automatic match without review
MATCH_HIGH_CONFIDENCE_THRESHOLD=95

# Audit Schedule Configuration
# Set to true to enable automated background audits
AUDIT_SCHEDULER_ENABLED=false
# Interval for recurring audit runs: 'hourly', 'every_6_hours', 'daily', or milliseconds (e.g. 21600000)
AUDIT_SCHEDULE_INTERVAL="every_6_hours"

# Apify Integration
# Get your token at https://console.apify.com/account#/integrations
APIFY_API_TOKEN=""

# Apify Actor IDs for specific platforms
# Zillow scraper actor (e.g., maxcopell/zillow-scraper or similar)
APIFY_ZILLOW_ACTOR_ID="X46xKaa20oUA1fRiP"
# Realtor.com scraper actor
APIFY_REALTOR_ACTOR_ID="realtor-scraper-actor-id"
# LACDB / Commercial scraper actor
APIFY_LACDB_ACTOR_ID="lacdb-scraper-actor-id"

# ==============================================================================
# Bright Data Integration
# ==============================================================================
BRIGHTDATA_API_TOKEN=""
BRIGHTDATA_PROXY_HOST="brd.superproxy.io:44445"
BRIGHTDATA_PROXY_USERNAME="brd-customer-hl_xxxxxx-zone-web_unlocker1"
BRIGHTDATA_PROXY_PASSWORD=""

# Real Estate Dataset / Collector IDs (if using Bright Data Datasets)
BRIGHTDATA_ZILLOW_DATASET_ID=""
BRIGHTDATA_REALTOR_DATASET_ID=""
BRIGHTDATA_LACDB_DATASET_ID=""
